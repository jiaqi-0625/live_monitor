# API
APP_NAME=汽车直播智能辅助工具
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_PATH=./storage/live-monitor.db
STORAGE_ROOT=./storage
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Accounts and permissions
AUTH_REQUIRED=true
AUTH_SESSION_DAYS=14
# Keep false for the current HTTP deployment; change to true after enabling HTTPS.
AUTH_COOKIE_SECURE=false
# Required before the first production start. Never commit the real password.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员

# ASR
# mock: verifies the realtime pipeline without transcribing speech.
# aliyun: enables Alibaba Cloud NLS realtime speech recognition.
ASR_PROVIDER=mock

# Required only when ASR_PROVIDER=aliyun.
# Create a RAM user for the application; do not use the primary account key.
ALIYUN_NLS_APPKEY=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_NLS_REGION_ID=cn-shanghai
ALIYUN_NLS_WEBSOCKET_URL=wss://nls-gateway.cn-shanghai.aliyuncs.com/ws/v1
# Optional custom generic vocabulary ID for car brands and model names.
ALIYUN_NLS_VOCABULARY_ID=

# Required only for direct AutoEngine (懂车云店) links.
# Keep this secret in services/api/.env and never commit it.
AUTOENGINE_COOKIE=

# OpenAI-compatible LLM. DeepSeek is the default provider.
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=
# Docker Compose also accepts this name from the project-root .env.
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-chat
DEEPSEEK_MODEL=deepseek-chat
LLM_ANALYSIS_INTERVAL_SECONDS=60
# 文件导入会调用此模型提炼、去重并生成固定 Markdown 语料；未配置时禁止文件导入。
# 可选：用于加密管理员在控制台保存的 API Key。生产环境建议显式配置 Fernet 密钥。
# APP_CONFIG_ENCRYPTION_KEY=

# Web
# Local development automatically follows the hostname used to open the web app.
# Set these only when the API is hosted on another address.
# VITE_API_BASE=https://api.example.com
# VITE_WS_BASE=wss://api.example.com
